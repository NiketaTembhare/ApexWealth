# =================================================================
# ApexWealth AI Banking Advisor - Environment Configuration Example
# =================================================================

# 🔑 OpenRouter API Key (Required for Gemini AI Advice & Chat)
# Replace with your actual OpenRouter key starting with sk-or-v1-...
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 🧠 AI Model choice
OPENROUTER_MODEL=google/gemini-2.5-flash

# 🔌 Backend Server configuration
PORT=8000

# 🔐 Optional: JWT Secret Key (Override for custom token signing)
# JWT_SECRET=your_super_secure_secret_key_here
